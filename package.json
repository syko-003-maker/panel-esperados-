{
  "name": "panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next && next build",
    "start": "node -r dotenv/config node_modules/next/dist/bin/next start",
    "start:prod": "npm run build && cross-env NODE_ENV=production DOTENV_CONFIG_PATH=.env.prod DOTENV_CONFIG_OVERRIDE=true concurrently --names \"next,worker,tunnel\" --prefix \"[{name}]\" \"npm run start\" \"npm run discord:start\" \"C:\\\\cloudflared.exe tunnel run los-esperados\"",
    "dev:promote-staff": "npx tsx scripts/dev-promote-staff.ts",
    "dev:promote-chef": "npx tsx scripts/dev-promote-chef.ts",
    "backfill:ghost-members": "npx tsx scripts/backfill-ghost-members-from-banklogs.ts",
    "sync:members:lyg": "npx tsx scripts/sync-members-from-lyg.ts",
    "discord:bot": "npx tsx scripts/discord-bot.ts",
    "discord:worker": "npx tsx scripts/discord-worker.ts",
    "discord:seedjob": "npx tsx scripts/seed-discord-job.ts",
    "discord:dev": "cd discord-worker && npm run dev",
    "discord:build": "cd discord-worker && npm run build",
    "discord:start": "cd discord-worker && cross-env NODE_ENV=production npm run start",
    "lint": "eslint",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.35.0",
    "@types/web-push": "^3.6.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.16.3",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^4.17.4",
    "lucide-react": "^0.563.0",
    "motion": "^12.38.0",
    "next": "16.1.3",
    "next-auth": "^4.24.13",
    "pg": "^8.17.1",
    "playwright": "^1.61.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.5",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
