# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env*.local

# Environment
.env
.env.local
.env.*.local

# Docker
docker-compose.override.yml

# Database
pgdata/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# Backups (dumps de base de données) — PAS les migrations Prisma
backups/
*.sql
*.sql.gz
# Exception : les migrations Prisma DOIVENT être versionnées (reproductibilité)
!prisma/migrations/**/*.sql

# Logs
/var/log/panel-backup.log

# Discord worker — dépendances et build
discord-worker/node_modules/
discord-worker/dist/

# Binaires lourds
bin/cloudflared*
bin/*.exe

# Fichiers accidentels
"ystemctl show panel-esperados -p MainPID --value)"
=

# Scripts de réparation (données sensibles)
scripts/*.json
scripts/*.mjs

# Backup files .env
.env.prod.bak.*
discord-worker/data/reglement-corpus.json

# Binaires desktop (servis mais non versionnés)
public/downloads/*.exe
public/downloads/*.dmg
public/downloads/*.AppImage
public/downloads/*.blockmap
