"use client";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";
import { StaffPage } from "../ui/StaffPage";
import { StaffTable } from "../ui/StaffTable";
import { Badge } from "../ui/Badge";

type Sanction = {
  id: string;
  memberId: string | null;
  memberDiscordId: string | null;
  memberName: string;
  type: "AVERT_ORAL_PLAYTIME" | "AVERT_ORAL_REUNION" | "AVERT_LEGER" | "AVERT_LOURD" | "DEMOTE" | "RESERVISTE" | "BLACKLIST";
  source: "MANUAL" | "ACTIVITY" | "MEETING" | "SYSTEM";
  reason: string | null;
  status: "ACTIVE" | "EXPIRED" | "CLOSED";
  discordStatus: "PENDING" | "APPLIED" | "FAILED";
  discordError: string | null;
  startAt: string;
  endAt: string | null;
  expiresAt: string | null;
  clearedAt: string | null;
  clearedStatus: string | null;
  clearedError: string | null;
  closedAt: string | null;
  createdAt: string;
  updatedAt: string;
  justificationsCount: number;
};

type MemberOption = {
  id: string;
  rpName: string;
  discordId: string | null;
};

type Justification = {
  id: string;
  authorDiscordId: string;
  message: string;
  status: string;
  createdAt: string;
};

const STATUSES: Sanction["status"][] = ["ACTIVE", "EXPIRED", "CLOSED"];
const TYPES: Sanction["type"][] = [
  "AVERT_ORAL_PLAYTIME",
  "AVERT_ORAL_REUNION",
  "AVERT_LEGER",
  "AVERT_LOURD",
  "DEMOTE",
  "RESERVISTE",
  "BLACKLIST",
];
const SOURCES: Sanction["source"][] = ["MANUAL", "ACTIVITY", "MEETING", "SYSTEM"];

const SOURCE_LABELS: Record<Sanction["source"], string> = {
  MANUAL: "Manuel",
  ACTIVITY: "Activité",
  MEETING: "Réunion",
  SYSTEM: "Système",
};

const STATUS_TONE: Record<Sanction["status"], "yellow" | "gray" | "green"> = {
  ACTIVE: "yellow",
  EXPIRED: "gray",
  CLOSED: "green",
};

const DISCORD_TONE: Record<Sanction["discordStatus"], "yellow" | "green" | "red"> = {
  PENDING: "yellow",
  APPLIED: "green",
  FAILED: "red",
};

function fmtDate(iso: string | null) {
  if (!iso) return "-";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString("fr-BE");
}

export default function SanctionsClient() {
  const [items, setItems] = useState<Sanction[]>([]);
  const [members, setMembers] = useState<MemberOption[]>([]);
  const [statusFilter, setStatusFilter] = useState("");
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [editForm, setEditForm] = useState({
    type: "AVERT_ORAL_PLAYTIME" as Sanction["type"],
    reason: "",
  });
  const [createForm, setCreateForm] = useState({
    memberId: "",
    type: "AVERT_ORAL_PLAYTIME" as Sanction["type"],
    reason: "",
  });
  const [justifications, setJustifications] = useState<Record<string, Justification[]>>({});
  const [justificationsLoading, setJustificationsLoading] = useState<Record<string, boolean>>({});

  async function loadMembers() {
    try {
      const res = await fetch("/api/staff/sanctions/members?familyId=esperados", {
        cache: "no-store",
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json?.ok) throw new Error(json?.error || "Failed to load members");
      setMembers(json.items ?? []);
    } catch (err: any) {
      setMembers([]);
      setError(String(err?.message ?? err));
    }
  }

  async function load() {
    setLoading(true);
    setError(null);
    try {
      const qs = new URLSearchParams();
      qs.set("familyId", "esperados");
      if (statusFilter) qs.set("status", statusFilter);
      const res = await fetch(`/api/staff/sanctions?${qs.toString()}`, { cache: "no-store" });
      const data = await res.json();
      if (!res.ok || !data?.ok) throw new Error(data?.error || "Failed to load");
      setItems(data.data ?? []);
    } catch (err: any) {
      setItems([]);
      setError(String(err?.message ?? err));
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, [statusFilter]);

  useEffect(() => {
    loadMembers();
  }, []);

  const selectedMember = useMemo(
    () => members.find((member) => member.id === createForm.memberId) ?? null,
    [members, createForm.memberId]
  );
  const missingDiscordId = Boolean(createForm.memberId && !selectedMember?.discordId);

  async function onCreate(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (missingDiscordId) {
      setError("Ce membre n'a pas de Discord ID");
      return;
    }
    setSaving(true);
    setError(null);

    const payload: Record<string, unknown> = {
      familyId: "esperados",
      memberId: createForm.memberId,
      type: createForm.type,
      reason: createForm.reason,
    };
    if (selectedMember?.discordId) {
      payload.memberDiscordId = selectedMember.discordId;
    }

    try {
      const res = await fetch("/api/staff/sanctions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json?.ok) throw new Error(json?.error || "Create failed");
      setCreateForm({
        memberId: "",
        type: "AVERT_ORAL_PLAYTIME",
        reason: "",
      });
      await load();
    } catch (err: any) {
      setError(String(err?.message ?? err));
    } finally {
      setSaving(false);
    }
  }

  function openEdit(item: Sanction) {
    setEditingId(item.id);
    setEditForm({
      type: item.type,
      reason: item.reason ?? "",
    });
  }

  async function submitEdit(item: Sanction) {
    const payload = {
      type: editForm.type,
      reason: editForm.reason,
    };

    try {
      const res = await fetch(`/api/staff/sanctions/${item.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json?.ok) throw new Error(json?.error || "Update failed");
      setEditingId(null);
      await load();
    } catch (err: any) {
      setError(String(err?.message ?? err));
    }
  }

  async function closeSanction(item: Sanction) {
    try {
      const res = await fetch(`/api/staff/sanctions/${item.id}/close`, { method: "POST" });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json?.ok) throw new Error(json?.error || "Close failed");
      await load();
    } catch (err: any) {
      setError(String(err?.message ?? err));
    }
  }

  async function toggleJustifications(item: Sanction) {
    if (justifications[item.id]) {
      setJustifications((prev) => {
        const next = { ...prev };
        delete next[item.id];
        return next;
      });
      return;
    }

    setJustificationsLoading((prev) => ({ ...prev, [item.id]: true }));
    try {
      const res = await fetch(`/api/staff/sanctions/${item.id}/justifications`, {
        cache: "no-store",
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json?.ok) throw new Error(json?.error || "Failed to load justifications");
      setJustifications((prev) => ({ ...prev, [item.id]: json.data ?? [] }));
    } catch (err: any) {
      setError(String(err?.message ?? err));
    } finally {
      setJustificationsLoading((prev) => ({ ...prev, [item.id]: false }));
    }
  }

  return (
    <StaffPage title="Sanctions" subtitle={`${items.length} sanction${items.length > 1 ? "s" : ""}`}>
      <div className="grid gap-6 lg:grid-cols-2">
        <form
          onSubmit={onCreate}
          className="border border-gray-200 rounded-lg bg-white p-4 grid gap-4 shadow-sm"
        >
          <div className="flex items-center justify-between">
            <div className="text-sm font-semibold text-gray-800">Créer une sanction</div>
            <Link href="/staff/sanctions/new" className="text-sm text-blue-600 hover:underline">
              Nouveau
            </Link>
          </div>
          <div className="grid gap-2">
            <label className="text-sm text-gray-600">Membre</label>
            <select
              name="memberId"
              value={createForm.memberId}
              onChange={(e) => setCreateForm((prev) => ({ ...prev, memberId: e.target.value }))}
              required
              className="border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">Selectionner...</option>
              {members.map((member) => (
                <option key={member.id} value={member.id}>
                  {member.rpName}
                </option>
              ))}
            </select>
            {missingDiscordId && (
              <div className="text-xs text-red-700">Ce membre n&apos;a pas de Discord ID</div>
            )}
          </div>

          <div className="grid gap-2">
            <label className="text-sm text-gray-600">Type</label>
            <select
              name="type"
              value={createForm.type}
              onChange={(e) =>
                setCreateForm((prev) => ({ ...prev, type: e.target.value as Sanction["type"] }))
              }
              className="border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              {TYPES.map((t) => (
                <option key={t} value={t}>
                  {t}
                </option>
              ))}
            </select>
          </div>

          <div className="grid gap-2">
            <label className="text-sm text-gray-600">Raison</label>
            <textarea
              name="reason"
              rows={3}
              value={createForm.reason}
              onChange={(e) => setCreateForm((prev) => ({ ...prev, reason: e.target.value }))}
              className="border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <button
            type="submit"
            disabled={saving || missingDiscordId}
            className="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold rounded bg-blue-600 text-white hover:bg-blue-700 disabled:bg-gray-200 disabled:text-gray-500 disabled:cursor-not-allowed"
          >
            {saving ? "Saving..." : "Create"}
          </button>
        </form>

        <div className="border border-gray-200 rounded-lg bg-white p-4 shadow-sm flex flex-col gap-3">
          <div className="text-sm font-semibold text-gray-800">Filtres</div>
          <label className="flex items-center gap-3 text-sm text-gray-700">
            Statut
            <select
              value={statusFilter}
              onChange={(e) => setStatusFilter(e.target.value)}
              className="border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="">Tous</option>
              {STATUSES.map((s) => (
                <option key={s} value={s}>
                  {s}
                </option>
              ))}
            </select>
          </label>
          {loading ? <span className="text-sm text-gray-600">⏳ Chargement...</span> : null}
        </div>
      </div>

      {error ? (
        <div className="p-3 border border-red-200 bg-red-50 text-red-800 rounded text-sm">{error}</div>
      ) : null}

      <StaffTable
        headers={["Membre", "Type", "Source", "Statut", "Discord", "Début", "Expire", "Raison", "Justifications", "Actions"]}
        stickyHeader
      >
        {items.length === 0 ? (
          <tr>
            <td colSpan={9} className="px-4 py-6 text-center text-gray-500">
              No entries
            </td>
          </tr>
        ) : (
          items.map((it) => {
            const isEditing = editingId === it.id;
            const statusTone = STATUS_TONE[it.status];

            return (
              <tr key={it.id} className="hover:bg-gray-50">
                <td className="px-4 py-3 font-semibold text-gray-800">
                  {it.memberDiscordId ? (
                    <Link href={`/staff/members/by-discord/${it.memberDiscordId}`} className="text-blue-600 hover:underline">
                      {it.memberName}
                    </Link>
                  ) : (
                    it.memberName
                  )}
                </td>
                <td className="px-4 py-3 text-sm text-gray-800">
                  {isEditing ? (
                    <select
                      value={editForm.type}
                      onChange={(e) =>
                        setEditForm((prev) => ({
                          ...prev,
                          type: e.target.value as Sanction["type"],
                        }))
                      }
                      className="border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                      {TYPES.map((t) => (
                        <option key={t} value={t}>
                          {t}
                        </option>
                      ))}
                    </select>
                  ) : (
                    it.type
                  )}
                </td>
                <td className="px-4 py-3 text-sm">
                  <Badge tone="gray">{SOURCE_LABELS[it.source] ?? it.source}</Badge>
                </td>
                <td className="px-4 py-3 text-sm">
                  <Badge tone={statusTone}>{it.status}</Badge>
                </td>
                <td className="px-4 py-3 text-sm">
                  <Badge tone={DISCORD_TONE[it.discordStatus]}>{it.discordStatus}</Badge>
                  {it.discordStatus === "FAILED" && it.discordError ? (
                    <div className="text-xs text-red-600 mt-1">{it.discordError}</div>
                  ) : null}
                </td>
                <td className="px-4 py-3 text-sm text-gray-700 whitespace-nowrap">{fmtDate(it.startAt)}</td>
                <td className="px-4 py-3 text-sm text-gray-700 whitespace-nowrap">
                  {it.expiresAt ? fmtDate(it.expiresAt) : "-"}
                  {it.clearedAt ? (
                    <div className="text-xs text-gray-600 mt-1">Levée: {fmtDate(it.clearedAt)}</div>
                  ) : null}
                </td>
                <td className="px-4 py-3 text-sm text-gray-700">
                  {isEditing ? (
                    <textarea
                      rows={2}
                      value={editForm.reason}
                      onChange={(e) => setEditForm((prev) => ({ ...prev, reason: e.target.value }))}
                      className="border border-gray-300 rounded px-2 py-1 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  ) : (
                    it.reason ?? "-"
                  )}
                </td>
                <td className="px-4 py-3 text-sm">
                  <button
                    type="button"
                    onClick={() => toggleJustifications(it)}
                    disabled={justificationsLoading[it.id]}
                    className="px-3 py-1 rounded text-sm font-semibold border border-gray-300 hover:bg-gray-50 disabled:opacity-60"
                  >
                    {justificationsLoading[it.id]
                      ? "Loading..."
                      : justifications[it.id]
                        ? "Hide"
                        : `View (${it.justificationsCount})`}
                  </button>
                </td>
                <td className="px-4 py-3 text-sm">
                  <div className="flex flex-wrap gap-2">
                    {isEditing ? (
                      <>
                        <button
                          type="button"
                          onClick={() => submitEdit(it)}
                          className="px-3 py-1 rounded text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700"
                        >
                          Save
                        </button>
                        <button
                          type="button"
                          onClick={() => setEditingId(null)}
                          className="px-3 py-1 rounded text-sm font-semibold border border-gray-300 hover:bg-gray-50"
                        >
                          Cancel
                        </button>
                      </>
                    ) : (
                      <>
                        <Link
                          href={`/staff/sanctions/${it.id}`}
                          className="px-3 py-1 rounded text-sm font-semibold border border-gray-300 hover:bg-gray-50"
                        >
                          View
                        </Link>
                        <button
                          type="button"
                          onClick={() => openEdit(it)}
                          className="px-3 py-1 rounded text-sm font-semibold border border-gray-300 hover:bg-gray-50"
                        >
                          Edit
                        </button>
                        {it.status !== "CLOSED" ? (
                          <button
                            type="button"
                            onClick={() => closeSanction(it)}
                            className="px-3 py-1 rounded text-sm font-semibold bg-amber-600 text-white hover:bg-amber-700"
                          >
                            Close
                          </button>
                        ) : null}
                      </>
                    )}
                  </div>
                </td>
              </tr>
            );
          })
        )}
      </StaffTable>

      {Object.keys(justifications).map((sanctionId) => {
        const entries = justifications[sanctionId];
        if (!entries) return null;
        return (
          <div key={sanctionId} className="border-t border-gray-200 pt-3">
            <div className="font-semibold mb-2">Justifications - {sanctionId}</div>
            {entries.length === 0 ? (
              <div className="text-sm text-gray-500">No justifications</div>
            ) : (
              <div className="grid gap-2">
                {entries.map((entry) => (
                  <div key={entry.id} className="p-3 border border-gray-200 rounded">
                    <div className="text-xs text-gray-500 mb-1">{fmtDate(entry.createdAt)}</div>
                    <div className="text-sm text-gray-800 whitespace-pre-wrap">{entry.message}</div>
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </StaffPage>
  );
}
